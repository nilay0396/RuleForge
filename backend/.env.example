# Backend environment template for local development and production deploys.
# Copy to backend/.env locally. Never commit real secrets.

APP_ENV=development
MONGO_URL=mongodb://localhost:27017
DB_NAME=ruleforge_dev
JWT_SECRET=replace-with-random-256-bit-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-random-password
FRONTEND_URL=http://localhost:3000
BCRYPT_ROUNDS=10
BCRYPT_THREAD_POOL_SIZE=32
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=
